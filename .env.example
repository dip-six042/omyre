# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Database name (optional, defaults to "omyre")
MONGODB_DB=omyre

# Password for /admin
ADMIN_PASSWORD=change-me-to-something-long

# Signs the admin login cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
